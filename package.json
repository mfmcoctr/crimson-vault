{
  "name": "personvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PersonVault — Yerel Şifreli Kişisel & Müşteri Kasası",
  "scripts": {
    "dev": "concurrently -n API,UI -c red,white \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/__tests__/*.test.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.57",
    "csv-parse": "^5.6.0",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.6",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}

